# Eldorado Seller API - OAuth 2.0 client credentials
# Panel: https://www.eldorado.gg/seller/api
ELDORADO_CLIENT_ID=
ELDORADO_CLIENT_SECRET=

# Telegram bot (BotFather'dan alinir)
TELEGRAM_BOT_TOKEN=

# Botun mesaj atacagi chat id. Bos birakilirsa bottan ilk mesaj atan
# (yani sen) otomatik kaydedilir.
TELEGRAM_CHAT_ID=

# Kac saniyede bir siparis kontrol edilsin (min 20)
POLL_SECONDS=45

# Otomatik teslimat varsayilan olarak kapali. Acmak icin bot icinden /oto on
AUTO_DELIVER=0

# Ayni anda calisan tek kopya kilidi
LOCK_PORT=7788
